{
  "name": "false-alarm",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "scripts": {
    "start": "node src/server/server.js",
    "devfrontend": "PORT=5000 REACT_APP_SOCKET_URL=http://localhost:3001 react-scripts start",
    "devbackend": "PORT=3001 node --watch --watch-preserve-output src/server/server.js",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test --env=jsdom --watchAll=false",
    "test:jsdom": "react-scripts test --env=jsdom --watchAll=false",
    "test:playwright": "playwright test",
    "build:server": "node scripts/bundle-server.mjs",
    "test:round": "node scripts/round.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(react-error-boundary)/)"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "esbuild": "^0.25.0",
    "react-scripts": "^5.0.1"
  },
  "homepage": "/false-alarm/",
  "engines": {
    "node": ">=24"
  }
}
